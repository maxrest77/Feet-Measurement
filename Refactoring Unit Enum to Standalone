// -------- Standalone Enum (Refactored) --------
enum LengthUnit {
    FEET(1.0),
    INCH(1.0 / 12.0),
    YARD(3.0),
    CM(0.0328084);

    private final double toFeetFactor;

    LengthUnit(double toFeetFactor) {
        this.toFeetFactor = toFeetFactor;
    }

    // Convert current unit → base unit (feet)
    public double convertToBase(double value) {
        return value * toFeetFactor;
    }

    // Convert base unit (feet) → current unit
    public double convertFromBase(double baseValue) {
        return baseValue / toFeetFactor;
    }
}


// -------- QuantityLength Class --------
class QuantityLength {
    private static final double EPSILON = 0.00001;

    private final Double value;
    private final LengthUnit unit;

    public QuantityLength(Double value, LengthUnit unit) {
        validate(value, unit);
        this.value = value;
        this.unit = unit;
    }

    private void validate(Double value, LengthUnit unit) {
        if (value == null || !Double.isFinite(value)) {
            throw new IllegalArgumentException("Invalid numeric value");
        }
        if (unit == null) {
            throw new IllegalArgumentException("Unit must not be null");
        }
    }

    // -------- Conversion --------
    public double convertTo(LengthUnit targetUnit) {
        if (targetUnit == null) {
            throw new IllegalArgumentException("Target unit must not be null");
        }
        double baseValue = unit.convertToBase(value);
        return targetUnit.convertFromBase(baseValue);
    }

    public static double convert(Double value, LengthUnit source, LengthUnit target) {
        if (value == null || !Double.isFinite(value)) {
            throw new IllegalArgumentException("Invalid numeric value");
        }
        if (source == null || target == null) {
            throw new IllegalArgumentException("Units must not be null");
        }

        double baseValue = source.convertToBase(value);
        return target.convertFromBase(baseValue);
    }

    // -------- Equality --------
    public boolean equals(QuantityLength other) {
        if (other == null) {
            throw new IllegalArgumentException("Other must not be null");
        }

        double thisBase = this.unit.convertToBase(this.value);
        double otherBase = other.unit.convertToBase(other.value);

        return Math.abs(thisBase - otherBase) < EPSILON;
    }

    // -------- UC6: Add (default unit) --------
    public QuantityLength add(QuantityLength other) {
        return add(this, other, this.unit);
    }

    // -------- UC7: Add with Target Unit --------
    public static QuantityLength add(QuantityLength l1,
                                     QuantityLength l2,
                                     LengthUnit targetUnit) {

        if (l1 == null || l2 == null) {
            throw new IllegalArgumentException("Inputs must not be null");
        }
        if (targetUnit == null) {
            throw new IllegalArgumentException("Target unit must not be null");
        }

        double base1 = l1.unit.convertToBase(l1.value);
        double base2 = l2.unit.convertToBase(l2.value);

        double sumBase = base1 + base2;

        double resultValue = targetUnit.convertFromBase(sumBase);

        return new QuantityLength(resultValue, targetUnit);
    }

    @Override
    public String toString() {
        return value + " " + unit;
    }
}


// -------- Main Class --------
public class QuantityMeasurementApp {

    public static void main(String[] args) {

        QuantityLength l1 = new QuantityLength(1.0, LengthUnit.FEET);
        QuantityLength l2 = new QuantityLength(12.0, LengthUnit.INCH);

        // Equality (UC3+)
        System.out.println("1 ft == 12 in: " + l1.equals(l2));

        // Conversion (UC5)
        double inches = l1.convertTo(LengthUnit.INCH);
        System.out.println("1 ft in inches: " + inches);

        // Addition default (UC6)
        QuantityLength sum1 = l1.add(l2);
        System.out.println("Sum (default): " + sum1);

        // Addition with target (UC7)
        QuantityLength sum2 = QuantityLength.add(l1, l2, LengthUnit.YARD);
        System.out.println("Sum in yards: " + sum2);
    }
}
